\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Violin plots por usuario. Distribuciones completas (densidad + cuartiles) mostrando heterogeneidad marcada entre participantes, evidenciando la necesidad de modelado personalizado mediante lógica difusa.}}{24}{figure.caption.8}\protected@file@percent }
\newlabel{fig:violin_plots}{{4.3}{24}{Violin plots por usuario. Distribuciones completas (densidad + cuartiles) mostrando heterogeneidad marcada entre participantes, evidenciando la necesidad de modelado personalizado mediante lógica difusa}{figure.caption.8}{}}
\newlabel{fig:violin_plots@cref}{{[figure][3][4]4.3}{[1][21][]24}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Perfiles de usuario: medianas normalizadas [0-1] para 8 variables clave. Se observan patrones heterogéneos, con algunos usuarios mostrando alta actividad física pero baja variabilidad cardíaca (e.g., u3), y viceversa (e.g., u7), evidenciando la complejidad del fenómeno sedentario.}}{25}{figure.caption.9}\protected@file@percent }
\newlabel{fig:grouped_bar_medianas}{{4.4}{25}{Perfiles de usuario: medianas normalizadas [0-1] para 8 variables clave. Se observan patrones heterogéneos, con algunos usuarios mostrando alta actividad física pero baja variabilidad cardíaca (e.g., u3), y viceversa (e.g., u7), evidenciando la complejidad del fenómeno sedentario}{figure.caption.9}{}}
