\@writefile{lof}{\contentsline {figure}{\numberline {9.8}{\ignorespaces Biplot de PCA (PC1 vs. PC2) usando las \textbf  {4 variables p50} como entrada. Los vectores de carga (flechas azules) muestran que PC1 está dominado por Delta\_cardiaco (0.632) y Superávit\_calórico (0.512), representando el eje de actividad física. PC2 está dominado por Superávit\_calórico (0.710) y HRV\_SDNN (0.457), representando el eje de salud cardiovascular. La separación ortogonal de estos dominios confirma que las 4 variables aportan información complementaria. \textbf  {Nota metodológica}: Los percentiles (p10, p90, IQR) se usaron para parametrizar funciones de pertenencia difusas (Tabla 11.2), NO como features de clustering.}}{67}{figure.caption.36}\protected@file@percent }
\newlabel{fig:pca_biplot}{{9.8}{67}{Biplot de PCA (PC1 vs. PC2) usando las \textbf {4 variables p50} como entrada. Los vectores de carga (flechas azules) muestran que PC1 está dominado por Delta\_cardiaco (0.632) y Superávit\_calórico (0.512), representando el eje de actividad física. PC2 está dominado por Superávit\_calórico (0.710) y HRV\_SDNN (0.457), representando el eje de salud cardiovascular. La separación ortogonal de estos dominios confirma que las 4 variables aportan información complementaria. \textbf {Nota metodológica}: Los percentiles (p10, p90, IQR) se usaron para parametrizar funciones de pertenencia difusas (Tabla 11.2), NO como features de clustering}{figure.caption.36}{}}
\newlabel{fig:pca_biplot@cref}{{[figure][8][9]9.8}{[1][66][]67}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.9}{\ignorespaces Comparativa de reducción dimensional: PCA (lineal, izquierda) vs. t-SNE (no-lineal, derecha) sobre las 4 variables p50. PCA muestra separación moderada entre clusters con overlap natural (esperado en transiciones graduales de comportamiento). t-SNE confirma estructura de agrupamiento local, validando que los datos tienen patrones detectables a pesar de la variabilidad inherente de datos de vida libre.}}{68}{figure.caption.37}\protected@file@percent }
\newlabel{fig:comparativa_pca_tsne}{{9.9}{68}{Comparativa de reducción dimensional: PCA (lineal, izquierda) vs. t-SNE (no-lineal, derecha) sobre las 4 variables p50. PCA muestra separación moderada entre clusters con overlap natural (esperado en transiciones graduales de comportamiento). t-SNE confirma estructura de agrupamiento local, validando que los datos tienen patrones detectables a pesar de la variabilidad inherente de datos de vida libre}{figure.caption.37}{}}
\newlabel{fig:comparativa_pca_tsne@cref}{{[figure][9][9]9.9}{[1][66][]68}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.3.2}Exploración en 3 Dimensiones (PC1-PC2-PC3)}{68}{subsection.9.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.10}{\ignorespaces PCA en 3 dimensiones (PC1-PC2-PC3) con 4 rotaciones. PC3 aporta 21.2\% de varianza adicional (total acumulado: 93.0\%), dominado por Actividad\_relativa (0.740). Las 4 vistas muestran la estructura espacial desde diferentes ángulos. A pesar del incremento en varianza explicada, la separación de clusters no mejora dramáticamente respecto a 2D, confirmando que PC1-PC2 capturan los ejes principales de sedentarismo.}}{69}{figure.caption.38}\protected@file@percent }
\newlabel{fig:pca_3d_4_vistas}{{9.10}{69}{PCA en 3 dimensiones (PC1-PC2-PC3) con 4 rotaciones. PC3 aporta 21.2\% de varianza adicional (total acumulado: 93.0\%), dominado por Actividad\_relativa (0.740). Las 4 vistas muestran la estructura espacial desde diferentes ángulos. A pesar del incremento en varianza explicada, la separación de clusters no mejora dramáticamente respecto a 2D, confirmando que PC1-PC2 capturan los ejes principales de sedentarismo}{figure.caption.38}{}}
\newlabel{fig:pca_3d_4_vistas@cref}{{[figure][10][9]9.10}{[1][68][]69}}
