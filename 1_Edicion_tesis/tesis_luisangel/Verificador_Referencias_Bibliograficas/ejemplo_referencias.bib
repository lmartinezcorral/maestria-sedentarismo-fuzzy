@article{Ejemplo2020,
  author = {Apellido, Nombre and Otro, Autor},
  title = {Título del artículo de ejemplo},
  journal = {Nombre de la Revista},
  volume = {10},
  number = {3},
  pages = {123--145},
  year = {2020},
  doi = {10.1234/ejemplo.2020.001}
}

@article{Ejemplo2021,
  author = {Autor, Ejemplo},
  title = {Otro artículo de ejemplo sin DOI},
  journal = {Revista de Ejemplo},
  year = {2021},
  note = {Este artículo no tiene DOI}
}

@book{EjemploLibro2022,
  author = {Autor, Libro},
  title = {Título del Libro},
  publisher = {Editorial Ejemplo},
  address = {Ciudad, País},
  year = {2022},
  isbn = {978-0-123456-78-9}
}

